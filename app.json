{
  "expo": {
    "name": "Flash Send",
    "slug": "sendapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/flash-send-icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "platforms": ["android"],
    "splash": {
      "image": "./assets/flash-send-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000080"
    },
    "androidStatusBar": {
      "backgroundColor": "#000080",
      "barStyle": "light-content"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#000080",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.flashsend.app",
      "versionCode": 2,
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CHANGE_WIFI_STATE",
        "android.permission.NEARBY_WIFI_DEVICES",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.INTERNET",
        "android.permission.CAMERA",
        "android.permission.WAKE_LOCK",
        "android.permission.REQUEST_INSTALL_PACKAGES",
        "android.permission.QUERY_ALL_PACKAGES"
      ],
      "blockedPermissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_DATA_SYNC"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-dev-client",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Flash Send to access your photos.",
          "savePhotosPermission": "Allow Flash Send to save photos.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      "./plugins/withAppQueries",
      "./plugins/withHotspotPermissions",
      "react-native-wifi-reborn"
    ],
    "extra": {
      "eas": {
        "projectId": "a3cfcde8-1aff-4fcd-921e-8c088167f269"
      }
    }
  }
}
