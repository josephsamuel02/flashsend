{
  "expo": {
    "name": "Flash Send",
    "slug": "sendapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/flash-send-icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/flash-send-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A1A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.flashsend.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Flash Send needs access to your photo library to share photos and videos.",
        "NSCameraUsageDescription": "Flash Send needs camera access to scan QR codes for device pairing.",
        "NSLocalNetworkUsageDescription": "Flash Send needs local network access to find and connect to nearby devices for file transfer.",
        "NSBonjourServices": [
          "_sendapp._tcp"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/flash-send-icon.png",
        "backgroundImage": "./assets/flash-send-icon.png",
        "monochromeImage": "./assets/flash-send-icon.png"
      },
      "package": "com.flashsend.app",
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CHANGE_WIFI_STATE",
        "android.permission.NEARBY_WIFI_DEVICES",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.INTERNET",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.QUERY_ALL_PACKAGES"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-dev-client",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Flash Send to access your photos.",
          "savePhotosPermission": "Allow Flash Send to save photos.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      "./plugins/withAppQueries",
      "./plugins/withHotspotPermissions",
      "react-native-wifi-reborn"
    ],
    "extra": {
      "eas": {
        "projectId": "a3cfcde8-1aff-4fcd-921e-8c088167f269"
      }
    }
  }
}
